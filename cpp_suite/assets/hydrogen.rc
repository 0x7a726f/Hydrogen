            VALUE "InternalName",     "hydrogen"
            VALUE "OriginalFilename", "hydrogen.exe"
            VALUE "ProductName",      "Hydrogen"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
